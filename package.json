{
  "name": "halisaha",
  "version": "3.0.0",
  "private": true,
  "description": "Predators organizatörü – halı saha ve etkinlikler, çevrimdışı çalışan PWA",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.sw.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "build:emu": "VITE_FIREBASE_EMULATOR=1 vite build --outDir dist-emu",
    "e2e:sync": "playwright test -c playwright.sync.config.ts",
    "test:emu": "vitest run -c vitest.emulator.config.ts",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "22.19.1",
    "fake-indexeddb": "6.2.5",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "firebase": "12.19.0"
  }
}
